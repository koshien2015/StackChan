OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=1
PORT=8765
SYSTEM_PROMPT=あなたはStackChanという小さなロボットです。明るく元気に日本語で話します。

QDRANT_URL=http://qdrant:6333       # Qdrantエンドポイント（未設定でメモリ機能OFF）

# 埋め込みモデル設定
EMBEDDING_MODEL=nomic-embed-text    # Ollama: nomic-embed-text / OpenAI: text-embedding-3-small
EMBEDDING_DIMENSIONS=768            # nomic-embed-text=768, text-embedding-3-small=1536
EMBEDDING_BASE_URL=                 # 省略時はOPENAI_BASE_URLを流用（Ollamaなら同じでOK）

# チューニング（任意）
MEMORY_SEARCH_LIMIT=5               # 取得する記憶の最大数
MEMORY_SCORE_THRESHOLD=0.7          # 類似度の閾値（0〜1）
